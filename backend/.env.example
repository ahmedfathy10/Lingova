# Backend environment variables for Railway / production
PORT=3000
HOST=0.0.0.0
ADMIN_EMAIL=admin@lingova.com
ADMIN_PASSWORD=admin123
FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/firebase-service-account.json
# Required in production to keep runtime JSON data across deploys.
# On Railway, attach a Volume mounted at /data and set this to /data.
LINGOVA_DATA_DIR=/data
# Optional: if you switch to Supabase later
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-key
